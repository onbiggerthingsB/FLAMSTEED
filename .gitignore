# Tooling / OS cruft
.gstack/
.superpowers/
.DS_Store

# Python (Phase 1+)
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Data artifact cache (reproducible from sources; see spec §3.1)
# Anchored to repo root so it does NOT match the src/wcmodel/data/ package.
/data/

# Daily-update run logs (scripts/daily_update.py provenance JSONL + nohup/cron stdout).
# The script is committed; its runtime logs are not.
/logs/

# Lockbox runtime artifacts (the LockboxRegistry's interprocess lock + atomic-write
# temp file). The registry JSON itself IS committed; these transient siblings are not.
/config/lockbox.lock
/config/lockbox.json.tmp

# Secrets — API keys NEVER get committed. Provide keys via a local .env at the repo
# root (e.g. THE_ODDS_API_KEY=...); the gated adapters read them, the file stays local.
.env
.env.*
!.env.example

# Paper ledgers (PAPER signal-only; never committed). The scanner appends +EV picks here;
# the realized-CLV settle layer reads/extends it. The SCANNER is committed, the ledger is not.
/reports/totals_paper_ledger.jsonl
/reports/live_paper_ledger.jsonl
/reports/value_paper_ledger.jsonl
