# Copy to .env (which is gitignored) and fill in real values.
# NEVER commit real keys. The forecast model spends ZERO API credits — these keys
# are used only by the OPTIONAL value scanner (src/wcmodel/value/), which is gated
# off by default and never feeds the model.

# Odds API key (the-odds-api.com) — paid. Used only by the gated value scanner.
THE_ODDS_API_KEY=

# Optional / deferred (injuries integration is not implemented). Leave empty.
API_FOOTBALL_KEY=
